PORT=8080
DB_PS_HOST=postgres
DB_PS_PORT=5432
DB_PS_USER=postgres
DB_PS_PASSWORD=your_password
DB_PS_DATABASE=payment_request

# RabbitMQ configuration
RABBITMQ_URL=amqp://payment_app:payment_app_dev@localhost:5672/
RABBITMQ_QUEUE=payment_requests

# Mercado Pago Master Access Token (required for webhook validation and payment status re-query)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-your_master_access_token_here

# Mercado Pago Webhook Secret (found in Mercado Pago Developer Dashboard -> Webhooks / Notificações)
MERCADO_PAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# Mercado Pago OAuth for Marketplace / Seller Split:
# - MERCADO_PAGO_OAUTH_CLIENT_ID: Your application's "Application ID" (App ID) from Mercado Pago dashboard.
# - MERCADO_PAGO_OAUTH_CLIENT_SECRET: Your application's "Client Secret" from Mercado Pago dashboard.
# - MERCADO_PAGO_OAUTH_REDIRECT_URI: Must match exactly the URL registered in your Mercado Pago App settings.
# - MERCADO_PAGO_OAUTH_TOKEN_FILE: Path to store encrypted seller credentials.
# - MERCADO_PAGO_OAUTH_ENCRYPTION_KEY: 32-byte base64 encoded key:
#   powershell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MERCADO_PAGO_OAUTH_CLIENT_ID=
MERCADO_PAGO_OAUTH_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/mercadopago/callback
MERCADO_PAGO_OAUTH_TOKEN_FILE=./data/mercado-pago-seller-token.enc
MERCADO_PAGO_OAUTH_ENCRYPTION_KEY=
