PORT=8080
DB_PS_HOST=postgres
DB_PS_PORT=5432
DB_PS_USER=postgres
DB_PS_PASSWORD=your_password
DB_PS_DATABASE=payment_request

# RabbitMQ configuration
RABBITMQ_URL=amqp://payment_app:payment_app_dev@localhost:5672/
RABBITMQ_QUEUE=payment_requests

# Optional Mercado Pago seller OAuth manual flow.
# Generate a 32-byte key and base64 encode it; never commit the real value.
MERCADO_PAGO_OAUTH_CLIENT_ID=
MERCADO_PAGO_OAUTH_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/mercadopago/callback
MERCADO_PAGO_OAUTH_TOKEN_FILE=./data/mercado-pago-seller-token.enc
MERCADO_PAGO_OAUTH_ENCRYPTION_KEY=
