PORT=8081
DB_PS_HOST=postgres
DB_PS_PORT=5432
DB_PS_USER=postgres
DB_PS_PASSWORD=your_password
DB_PS_DATABASE=payment_request

# RabbitMQ configuration
RABBITMQ_URL=amqp://payment_app:payment_app_dev@localhost:5672/
RABBITMQ_QUEUE=payment_requests
STRIPE_API_KEY=sk_test_your_key_here

# Mercado Pago credentials (Marketplace master account):
# - MERCADO_PAGO_ACCESS_TOKEN: Master Access Token (TEST-... or APP_USR-...) from developer dashboard.
# - MERCADO_PAGO_WEBHOOK_URL: Webhook callback URL where MP sends payment events.
# - PIX_EXPIRATION_TIME: Expiration in minutes (default 30).
MERCADO_PAGO_ACCESS_TOKEN=TEST-your_master_access_token_here
MERCADO_PAGO_WEBHOOK_URL=http://localhost:8080/webhook/mercadopago
PIX_EXPIRATION_TIME=30

# Must point to the same encrypted seller token file and key used by payment-request-api.
MERCADO_PAGO_OAUTH_TOKEN_FILE=./data/mercado-pago-seller-token.enc
MERCADO_PAGO_OAUTH_ENCRYPTION_KEY=
